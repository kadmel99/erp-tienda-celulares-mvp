# Base de datos local (desarrollo)
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_tienda_celulares"
DIRECT_URL="postgresql://postgres:password@localhost:5432/erp_tienda_celulares"

# Supabase (para Storage y Auth de NextAuth si aplica)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# NextAuth
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# Email (envío de factura interna a la contadora)
SMTP_HOST=""
