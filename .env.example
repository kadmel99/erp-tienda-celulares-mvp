# Supabase Postgres (Settings > Database > Connection string, modo "Transaction")
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Conexión directa (para migraciones, sin pgbouncer)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Storage (fotos de producto, PDFs de factura/acta de entrega)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# NextAuth
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# Email (envío de factura interna a la contadora)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="notificaciones@tudominio.com"
