generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Administración ────────────────────────────────────────────────

enum UserRole {
  ADMIN_GENERAL
  OPERADOR
}

model Sucursal {
  id        String   @id @default(cuid())
  nombre    String
  ciudad    String
  direccion String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  usuarios    Usuario[]
  productos   Product[]
  ventas      Sale[]
  apartados   Apartado[]
  cajas       CashRegisterSession[]
  facturas    Invoice[]
  prospectos  Prospecto[]

  @@map("sucursales")
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          UserRole
  sucursalId   String?  @map("sucursal_id")
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sucursalId])
  @@map("usuarios")
}

// ── Inventario ───────────────────────────────────────────────────

enum ProductCondition {
  NUEVO
  USADO
  REACONDICIONADO
  EXHIBICION
}

enum ProductCategory {
  IPHONE
  IPAD
  APPLE_WATCH
  AIRPODS
  FORRO
  CARGADOR
  VIDRIO
  ACCESORIO
}

model Product {
  id            String           @id @default(cuid())
  sku           String           @unique
  nombre        String
  categoria     ProductCategory
  marca         String?
  modelo        String?
  color         String?
  capacidad     String?
  imei          String?          @unique
  serial        String?
  condicion     ProductCondition @default(NUEVO)
  costo         Decimal          @db.Decimal(12, 2)
  precioVenta   Decimal          @map("precio_venta") @db.Decimal(12, 2)
  tieneGarantia Boolean          @default(false) @map("tiene_garantia")
  mesesGarantia Int?             @map("meses_garantia")
  imageUrl      String?          @map("image_url")
  disponible    Boolean          @default(true) // false mientras está apartado o ya vendido
  createdAt     DateTime         @default(now()) @map("created_at")

  sucursalId  String   @map("sucursal_id")
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id])

  movimientos InventoryMovement[]
  saleItems   SaleItem[]
  apartados   Apartado[]
  tradeInDe   TradeIn[]           @relation("TradeInProductoResultante")
  warranties  Warranty[]

  @@index([sucursalId])
  @@index([imei])
  @@map("products")
}

enum InventoryMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  TRASLADO
}

model InventoryMovement {
  id            String                 @id @default(cuid())
  productId     String                 @map("product_id")
  product       Product                @relation(fields: [productId], references: [id])
  tipo          InventoryMovementType
  cantidad      Int                    @default(1)
  motivo        String?
  referenceType String?                @map("reference_type") // VENTA | APARTADO | PAGO_ESPECIE | RECEPCION | AJUSTE
  referenceId   String?                @map("reference_id")
  userId        String                 @map("user_id")
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// ── Clientes y prospectos ──────────────────────────────────────────

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  correo    String?
  ciudad    String?
  createdAt DateTime @default(now()) @map("created_at")

  ventas    Sale[]
  apartados Apartado[]

  @@map("clientes")
}

model Prospecto {
  id              String   @id @default(cuid())
  nombre          String?
  telefono        String?
  correo          String?
  productoInteres String?  @map("producto_interes")
  presupuesto     Decimal? @db.Decimal(12, 2)
  origen          String   @default("QR")
  sucursalId      String   @map("sucursal_id")
  sucursal        Sucursal @relation(fields: [sucursalId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sucursalId])
  @@map("prospectos")
}

// ── Ventas (POS) ────────────────────────────────────────────────

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  MIXTO
}

model Sale {
  id         String        @id @default(cuid())
  sucursalId String        @map("sucursal_id")
  sucursal   Sucursal      @relation(fields: [sucursalId], references: [id])
  clienteId  String?       @map("cliente_id")
  cliente    Cliente?      @relation(fields: [clienteId], references: [id])
  userId     String        @map("user_id")
  total      Decimal       @db.Decimal(12, 2)
  metodoPago PaymentMethod @map("metodo_pago")
  createdAt  DateTime      @default(now()) @map("created_at")

  items   SaleItem[]
  invoice Invoice?
  tradeIn TradeIn?

  @@index([sucursalId, createdAt])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String  @map("sale_id")
  sale       Sale    @relation(fields: [saleId], references: [id])
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
  cantidad   Int     @default(1)
  precioUnit Decimal @map("precio_unit") @db.Decimal(12, 2)

  @@map("sale_items")
}

// ── Apartados y cartera ────────────────────────────────────────

enum ApartadoStatus {
  ACTIVO
  SALDADO
  CANCELADO
}

model Apartado {
  id             String         @id @default(cuid())
  sucursalId     String         @map("sucursal_id")
  sucursal       Sucursal       @relation(fields: [sucursalId], references: [id])
  clienteId      String         @map("cliente_id")
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  productId      String         @map("product_id")
  product        Product        @relation(fields: [productId], references: [id])
  valorTotal     Decimal        @map("valor_total") @db.Decimal(12, 2)
  saldoPendiente Decimal        @map("saldo_pendiente") @db.Decimal(12, 2)
  fechaLimite    DateTime?      @map("fecha_limite")
  status         ApartadoStatus @default(ACTIVO)
  userId         String         @map("user_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  abonos       Abono[]
  seguimientos CarteraSeguimiento[]

  @@index([sucursalId, status])
  @@map("apartados")
}

model Abono {
  id         String        @id @default(cuid())
  apartadoId String        @map("apartado_id")
  apartado   Apartado      @relation(fields: [apartadoId], references: [id])
  monto      Decimal       @db.Decimal(12, 2)
  metodoPago PaymentMethod @map("metodo_pago")
  reciboUrl  String?       @map("recibo_url")
  userId     String        @map("user_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("abonos")
}

model CarteraSeguimiento {
  id            String    @id @default(cuid())
  apartadoId    String    @map("apartado_id")
  apartado      Apartado  @relation(fields: [apartadoId], references: [id])
  nota          String
  proximaAccion DateTime? @map("proxima_accion")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("cartera_seguimientos")
}

// ── Pago en especie ──────────────────────────────────────────────

model TradeIn {
  id                   String   @id @default(cuid())
  saleId               String   @unique @map("sale_id")
  sale                 Sale     @relation(fields: [saleId], references: [id])
  imei                 String?
  modelo               String
  condicion            String
  saludBateria         String?  @map("salud_bateria")
  observaciones        String?
  valorReconocido      Decimal  @map("valor_reconocido") @db.Decimal(12, 2)
  productoResultanteId String?  @map("producto_resultante_id")
  productoResultante   Product? @relation("TradeInProductoResultante", fields: [productoResultanteId], references: [id])
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("trade_ins")
}

// ── Facturación interna ──────────────────────────────────────────

enum InvoiceStatus {
  EMITIDA
  ANULADA
}

model Invoice {
  id                 String        @id @default(cuid())
  sucursalId         String        @map("sucursal_id")
  sucursal           Sucursal      @relation(fields: [sucursalId], references: [id])
  saleId             String        @unique @map("sale_id")
  sale               Sale          @relation(fields: [saleId], references: [id])
  numero             Int
  pdfUrl             String        @map("pdf_url")
  status             InvoiceStatus @default(EMITIDA)
  enviadaContadoraEn DateTime?     @map("enviada_contadora_en")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@unique([sucursalId, numero])
  @@map("invoices")
}

// ── Caja y caja menor ────────────────────────────────────────────

model CashRegisterSession {
  id                 String    @id @default(cuid())
  sucursalId         String    @map("sucursal_id")
  sucursal           Sucursal  @relation(fields: [sucursalId], references: [id])
  userId             String    @map("user_id")
  saldoInicial       Decimal   @map("saldo_inicial") @db.Decimal(12, 2)
  saldoFinalEsperado Decimal?  @map("saldo_final_esperado") @db.Decimal(12, 2)
  saldoFinalContado  Decimal?  @map("saldo_final_contado") @db.Decimal(12, 2)
  diferencia         Decimal?  @db.Decimal(12, 2)
  abiertaEn          DateTime  @default(now()) @map("abierta_en")
  cerradaEn          DateTime? @map("cerrada_en")

  movimientos CashMovement[]

  @@index([sucursalId, abiertaEn])
  @@map("cash_register_sessions")
}

enum CashMovementType {
  INGRESO_VENTA
  INGRESO_ABONO
  INGRESO_CAJA_MENOR
  EGRESO_CAJA_MENOR
  OTRO
}

model CashMovement {
  id          String               @id @default(cuid())
  sessionId   String               @map("session_id")
  session     CashRegisterSession  @relation(fields: [sessionId], references: [id])
  tipo        CashMovementType
  monto       Decimal              @db.Decimal(12, 2)
  concepto    String?
  referenceId String?              @map("reference_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@map("cash_movements")
}

// ── Postventa / garantías ─────────────────────────────────────────

enum WarrantyStatus {
  RECIBIDO
  EN_REVISION
  EN_REPARACION
  ENVIADO_PROVEEDOR
  APROBADO
  RECHAZADO
  ENTREGADO
}

model Warranty {
  id          String         @id @default(cuid())
  productId   String         @map("product_id")
  product     Product        @relation(fields: [productId], references: [id])
  clienteId   String         @map("cliente_id")
  motivo      String
  diagnostico String?
  status      WarrantyStatus @default(RECIBIDO)
  userId      String         @map("user_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("warranties")
}
